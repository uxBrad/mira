# Server — copy to .env.local

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT secrets (generate with: openssl rand -hex 64)
JWT_SECRET=change-me-generate-with-openssl-rand-hex-64
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-hex-64

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# Resend (email)
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@groundsforaccess.com

# App URL (deployed server URL for deep links)
APP_URL=https://api.groundsforaccess.com
